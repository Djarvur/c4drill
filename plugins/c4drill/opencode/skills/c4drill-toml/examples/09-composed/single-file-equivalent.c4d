# Composed Example - hand-expanded single-file equivalent; C4D twin of
# single-file-equivalent.toml. The same model as the entry.c4d include graph
# with templates expanded and includes merged (XC-05 golden pair).
properties {
  name: Composed Example
  description: include + templates + relative-peer + reference in one model
  edges: spline
  expanded: [platform]
}

platform: system "Platform" {
  description: Hosts the instantiated auth service and the included audit-log domain
  auditLog: container "Audit Log Domain" {
    description: Appended via include from domains/auth.toml (D-10)
    sink: componentQueue "Audit Sink" {
      description: Drains audit events from the bus
      -> messageBus: Consumes audit events from the backbone
    }
  }
  auth: container "auth Service" {
    description: auth handles authentication
    technology: "Go, gRPC"
    reference: https://wiki.example.com/auth
    cache: componentDb "auth Cache" {
      technology: Redis
      -> messageBus: Publishes authentication cache invalidations
    }
  }
}

messageBus: queue "Message Bus" { description: "Top-level backbone; instantiation-site target for the template link" }

customer: person "Customer" {
  description: End user whose requests reach the instantiated auth service
  -> platform.auth.cache: "HTTPS | Reads auth-cache entries produced by the instantiated service"
}
