# If you prefer to allow list template instead of deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Build output directories
/bin/
/dist/
/build/

# Environment files
.env
.env.*
*.local

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Debug files
debug
debug.test

# Temporary files
tmp/
temp/
*.tmp

# Log files
*.log

# OS-specific files
Thumbs.db
.DS_Store

.roo
.opencode

draft.txt
/c4drill

# GSD runtime installs for other tools (reinstallable via npx get-shit-done-cc)
.agent/
.cursor/

# Private test data — cyp-auth-infra architecture (keep local, never commit)
cyp-auth-infra/

# GSD runtime state (hooks write-gate state, per-machine)
.gsd/

# Node/Playwright (local verification tooling, not a project dependency)
node_modules/
package.json
package-lock.json

# ZCode session artifacts
.zcode/plans/

# Leftover verification output in testdata (regenerated by tests, not golden)
cmd/c4drill/testdata/multilevel.svg
cmd/c4drill/testdata/multilevel/
