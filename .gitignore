# If you prefer to allow list template instead of deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Build output directories
/bin/
/dist/
/build/

# Environment files
.env
.env.*
*.local

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Debug files
debug
debug.test

# Temporary files
tmp/
temp/
*.tmp

# Log files
*.log

# OS-specific files
Thumbs.db
.DS_Store

.roo
.opencode

draft.txt
/c4drill

# Compiled binary (build artifact)
cmd/c4drill/c4drill

# Generated diagram outputs (regenerated by c4drill, not golden)
skill/examples/**/*.dot
skill/examples/**/*.svg

# GSD runtime installs (reinstallable via npx get-shit-done-cc)
.agent/
.claude/
.cursor/
.zcode/

# GSD GitHub-native install (reinstallable via npx get-shit-done-cc) — keep workflows/
.github/agents/
.github/skills/
.github/copilot-instructions.md
.github/get-shit-done/
.github/gsd-file-manifest.json
.github/gsd-install-state.json
.github/gsd-migration-journal/
.github/.gsd-profile

# Background-shell manifest (tool state, empty placeholder)
.bg-shell/

# Serena (unused — removed 2026-08-09)
.serena/

# Private test data — cyp-auth-infra architecture (keep local, never commit)
cyp-auth-infra/

# GSD runtime state (hooks write-gate state, per-machine)
.gsd/

# Node/Playwright (local verification tooling, not a project dependency)
node_modules/
package.json
package-lock.json

# ...except the VS Code extension (extension/), which is a real npm project
!extension/package.json
!extension/package-lock.json

# ...and the Zed extension (zed-extension/), whose tree-sitter grammar is a
# real npm project; target/ is the wasm build output (issue #30)
zed-extension/target/
!zed-extension/grammars/c4d/package.json
!zed-extension/grammars/c4d/package-lock.json

# ...and the GUI frontend (gui/frontend/, issue #31) — a real npm project, so
# its package manifests are tracked despite the global package.json ignore;
# node_modules/ stays ignored via the global rule, dist/ via the negation
# below except the placeholder that keeps `go build` working without npm.
!gui/frontend/package.json
!gui/frontend/package-lock.json
gui/frontend/dist/*
!gui/frontend/dist/.gitkeep

# ZCode session artifacts
.zcode/plans/

# Leftover verification output in testdata (regenerated by tests, not golden)
cmd/c4drill/testdata/multilevel.svg
cmd/c4drill/testdata/multilevel.expanded.svg
cmd/c4drill/testdata/multilevel/

# JetBrains plugin build output (idea-plugin/, issue #29)
idea-plugin/.gradle/
idea-plugin/build/
idea-plugin/.idea/

# IntelliJ Platform Gradle Plugin working dir
idea-plugin/.intellijPlatform/
